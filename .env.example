# Copy to `.env` (never commit `.env`). Values below are placeholders.
# NOTE: Users' Groq / Gemini keys are NOT configured here — they are supplied
# per user in the app (BYOK) and stored encrypted in the database.

# ---------- Backend (Render) ----------
APP_ENV=development
DATABASE_URL=sqlite:///./researchpilot.db          # Supabase Postgres URL in production
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
KEY_ENCRYPTION_SECRET=<fernet-key>                  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENALEX_MAILTO=<team-contact-email>                # polite-pool identification for OpenAlex
SEMANTIC_SCHOLAR_API_KEY=                           # optional

# Development-only fallback keys (used by local scripts/tests, never in production)
DEV_GROQ_API_KEY=
DEV_GEMINI_API_KEY=

# ---------- Frontend (Vercel) ----------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
